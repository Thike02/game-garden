# Copy this file to .env and fill in the values. Never commit .env.

# Steam: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# 17-digit SteamID64 (profile "Game details" must be public)
STEAM_ID=

# IsThereAnyDeal: https://isthereanydeal.com/apps/my/
ITAD_API_KEY=

# Discord channel webhook for sale notifications
DISCORD_WEBHOOK_URL=

# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only (collector scripts / local admin). Never expose to the web page.
SUPABASE_SERVICE_ROLE_KEY=

# Store region for prices
STEAM_COUNTRY_CODE=JP
